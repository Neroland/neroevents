{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "NeroEvents - multiloader build (Fabric).",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "neroevents_logo.png",
  "accessWidener": "neroevents.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": ["za.co.neroland.neroevents.fabric.NeroEventsFabric"],
    "client": ["za.co.neroland.neroevents.fabric.NeroEventsFabricClient"]
  },
  "mixins": [
    "neroevents-common.mixins.json",
    "neroevents.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version} <${minecraft_version_ceiling}",
    "java": ">=21",
    "fabric-api": "*",
    "nerolandcore": ">=${nerolandcore_version} <2.0.0"
  },
  "suggests": {
    "neroeconomy": ">=0.4.0-beta.1"${nerospace_suggest}${nerocreatures_suggest}${nerocolonies_suggest}${neroagriculture_suggest}${nerofactions_suggest}${opac_suggest}
  }
}
